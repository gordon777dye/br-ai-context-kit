
logging  11,c:\ads\start_log.ads.txt
@ODBC logging  11,c:\ads\start_log.odbc.txt

DRIVE m:,c:\ads,xxx,\qsmrp
DRIVE c:,c:\,yyy,\ads_test
DRIVE e:,e:\,yyy,\

editor "C:\Program Files (x86)\Mills Enterprise\MyEditBR\myeditbr.exe"        

setenv PD \tisdale\
font terminal

printdir m:\qsmrp\prt +channel
wbserver C:\ads_test

application_name Advantage QS MRP

rem picture=\sys\br.d\ADSworld.gif,rows=25,cols=80

rem screen opendflt "font=Roman"
rem screen opendflt font=max,caption=ADS
rem statusline off

wsid=unique
option 14 ! allow multiple locks on same record from duplicate opens, for same file opened twice at same station 
option 25 ! make file$(0) -> CON: 
option 27 ! Ignore Invalid Y2K Key Data (err 4120) 
option 32 ! Suppress notification of error 6245 Which indicates an invalid or unsupported (by BR) escape sequence 
option 37 ! Cause BR to return old FKey value when someone uses the right arrow to exit a field 
option 38 ! This suppresses an error caused by specification of an N in the trailing attribute position. 
option 39 ! Suppress colon right alignment for labels.
option 40 ! Default hot text to appear as buttons.
option 41 ! Ignore GUI statements when they are encountered in non-GUI mode. 
option 43 ! Use old style Input Select with respect to setting CURFLD to the NXTFLD value when a selection is made.
option 44 ! Make the mouse wheel produce the same result as the arrow keys 
option 45 ! allows the old method of extended field specification in addition to the new method. 
option 46 ! suppress field+ and field- key functionality - treat + and - like + and -
option 47 ! Enable the continued use of PRINTER= in OPEN statements.
option 50 ! Suppress theme usage for text controls. This enables the Windows classical look under XP. 
option 55 ! This option causes BR to specifically position each character. 
option 56 ! Make SRCH return -1 when a matching index is not found.
option 58 ! Allow ON FNKEY syntax (in addition to ON FKEY).
! option 60 Save in the format used by 4.18 and earlier releases.
option 62 ! Use line draw border specification.
option 65 ! Ignore ON ATTN statements.

insert on min_length 10 ! use insert mode for 10 or more characters

option 33 64 ! use 64 bit record locking

attribute [inactive]/B:#E9E7E2

screen n 70,r 3f,b f3,u 01F1,h 71,i [inactive]  ! green cursor bar

rem screen n [test],r 3f,b f3,u 01F1,h 71,i [inactive]  ! green cursor bar

rem SANDSTONE
rem  #FFEEDD  #E4D3C0  #CAB9A3  #AF9E86  #948368  #79684B  #5F4E2E #443311  light->dark
rem ATTRIBUTE [C1]#FFEEDD
rem ATTRIBUTE [C2]#E4D3C0
rem ATTRIBUTE [C3]#CAB9A3
rem ATTRIBUTE [C4]#AF9E86
rem ATTRIBUTE [C5]#948368
rem ATTRIBUTE [C6]#79684B
rem ATTRIBUTE [C7]#5F4E2E
rem ATTRIBUTE [C8]#443311

rem ATTRIBUTE [NORMAL]/#443311:#FFEEDD
rem ATTRIBUTE [UNDERLINE]/[C8]:C3]
rem ATTRIBUTE [HILIGHT]/[C2]:[C4]
rem ATTRIBUTE [REVERSE]/[C1]:[C8]
rem ATTRIBUTE [BLINK]/[C2]:[C8]
rem ATTRIBUTE [INVISIBLE]/[C1]:[C1]
rem ATTRIBUTE [CONSOLE]/[C8]:[C1]
rem ATTRIBUTE [STATUSLINE]/[C6]:[C1]
rem ATTRIBUTE [INACTIVE]/[C4]:[C1]

rem SCREEN N [normal], U [underline], H [hilight], R [reverse], B [blink], I [invisible], C [console], S [statusline]

rem SCREEN OPENDFLT "N=/#5F4E2E:#E4D3C0,FONT.TEXT=MS SHELL DLG 2:SWISS:medium"


3D_FIELDS UNDR_on

substitute reports\ reports\ads\

graphic_linedraw sunken
gui off

workstack 120000
forstack 200
flowstack 500
rpnstack 2999

rem keyboard 03 01          ! map control+c to control+a

cursor 0109
maxrecall 190
style indent 3 45 keywords lower labels mixed expressions upper

! statusline rowcol on

rem spoolcmd prt.bat [SPOOLFILE] [COPIES] [PRINTER]
SPOOLCMD -w cnp\null_ptr.bat [SPOOLFILE] 

substitute prn:/10 preview:10/default
substitute prn:/20 preview:20/select
substitute PRN:/30 DIRECT:30/2844
substitute PRN:/40 DIRECT:40/default
substitute prn:/50 preview:50/default
substitute prn:/60 preview:/Generic
substitute prn:/70 DIRECT:70/select

printscreen gui
printer type NWP select 10
printer type NWP select 20
printer type PCLL select 40
printer type NWPL select 50
printer type NWPL select PDF:
printer type PCL select 70

include wsids

include printer.sys
include printer.landscape.sys

printer PCL INIT HP,"\E&l0O\E(s1b4102T\E&k2s2G\E&l66p7.6C" ! portrait compressed
printer PCLL INIT HP,"\E&l1O\E(s1b4102T\E&k2s2G\E&l66p7.6C" ! landscape compressed

printer NWP INIT "\E&l0O\E(s2b4099t17H\E&l66p7.6C"  ! portrait compressed ###########
printer NWPL INIT "\E&l1O\E(s2b4102t17H\E&l66p7.6C"  ! landscape compressed ###########

baseyear 1940

SHELL  LIMIT  -1


execute run cnp\startup